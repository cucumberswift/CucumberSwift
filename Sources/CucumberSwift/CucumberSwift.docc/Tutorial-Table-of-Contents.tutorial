@Tutorials(name: "Getting started") {
    @Intro(title: "Getting started with CucumberSwift") {
        Install CucumberSwift and set up a test target in your project. The tutorials end with the setup of the [GettingStarted](https://github.com/cucumberswift/CucumberSwiftSample/tree/main/Tuist/GettingStarted) sample in [CucumberSwiftSample](https://github.com/cucumberswift/CucumberSwiftSample).
    }
    
    @Chapter(name: "Installation") {
        @Image(source: "CucumberSwiftSuccessfulTestRun.png", alt: "Xcode's test navigator after a passing run of the Calculator feature, with the scenario and each of its steps.")
        How to install CucumberSwift and add it to your project.
        @TutorialReference(tutorial: "doc:SPM-Step-By-Step")
        @TutorialReference(tutorial: "doc:Carthage-Step-By-Step")
    }
}
