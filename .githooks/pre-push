#!/bin/sh
# Runs Trunk's linters (.trunk/trunk.yaml) on every commit being pushed, which catches a
# commit made with --no-verify, and the Python script tests. See .githooks/pre-commit.
# Skip them for one push with git push --no-verify.
set -e

# Each branch runs its own copy of this hook; see .githooks/pre-commit.
real() { (cd "$(dirname "$1")" 2>/dev/null && echo "$(pwd -P)/$(basename "$1")"); }
own="$(git rev-parse --show-toplevel)/.githooks/$(basename "$0")"
if [ "$(real "$0")" != "$(real "$own")" ]; then
  if [ -x "$own" ]; then exec "$own" "$@"; fi
  exit 0
fi

# Git passes the refs being pushed on stdin; Trunk reads them from a file.
refs=$(mktemp)
trap 'rm -f "$refs"' EXIT
cat > "$refs"

MISE_ENV=lint mise exec -- trunk check --no-fix --no-progress -t git-push \
  --commit-ref-from-pre-push "$refs"

# Without git's hook variables: some tests run git in repositories of their own.
# shellcheck disable=SC2046 # one variable name per word
(unset $(git rev-parse --local-env-vars); python3 -m unittest discover -s .github/scripts)
