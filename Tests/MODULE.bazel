# Runs the consumer test suites against cucumberswift as a dependency, the way a
# Bazel project uses it. Run Bazel from this folder.
module(name = "cucumberswift_tests")

bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_apple", version = "5.2.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_swift", version = "4.1.2")
bazel_dep(name = "cucumberswift")
local_path_override(
    module_name = "cucumberswift",
    path = "..",
)

# rules_swift scans only the macOS and iOS SDKs for system modules unless the root module asks
# for more. The tvOS simulator tests (consumer_tests.bzl) need the tvOS Simulator SDK.
system_sdk = use_extension("@rules_swift//swift:extensions.bzl", "system_sdk")
system_sdk.configure_sdks(names = ["AppleTVSimulator"])
