# Each iOS test runs on a simulator that rules_apple creates and boots, and the first
# boot of a new simulator migrates its data, which can take minutes. Booting one for
# each suite at once ran past the timeout in CI, so run the tests one at a time (the
# later suites then reuse the booted simulator), and give each test longer than the
# default 300 seconds.
test --local_test_jobs=1
test --test_timeout=900

# `bazel coverage` on Apple platforms: build with LLVM's coverage format, which CucumberSwift reads
# (Bazel's default is gcov's, whose runtime the test bundle doesn't link). Add these lines to your
# project's .bazelrc too.
coverage --features=llvm_coverage_map_format
coverage --features=-gcc_coverage_map_format
# Count only the code under test, Grades.
coverage --instrumentation_filter=//:Grades
