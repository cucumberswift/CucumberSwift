load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":consumer_tests.bzl", "consumer_tests")
load("@cucumberswift//bazel:xctest_runner.bzl", "macos_xctest_runner")
load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_apple//apple:resources.bzl", "apple_resource_group")
load("@rules_apple//apple:watchos.bzl", "watchos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load(":xctest_runner_info_test.bzl", "xctest_runner_info_test")

# From this folder: `bazel test //... --test_tag_filters=-tvos` runs each suite on macOS, on an
# iOS simulator and on a watchOS simulator, and builds it for tvOS. rules_apple can't run tvOS
# tests (see consumer_tests.bzl). CI leaves watchOS out with -watchos in both tag filters.

macos_xctest_runner(name = "macos_xctest_runner")

# Checks the runner's script with a stand-in for xctest.
sh_test(
    name = "xctest_runner_test",
    srcs = ["xctest_runner_test.sh"],
    args = ["$(rootpath @cucumberswift//bazel:xctest_runner.template.sh)"],
    data = ["@cucumberswift//bazel:xctest_runner.template.sh"],
)

# Checks the runner passes on the Xcode that Bazel selected.
xctest_runner_info_test(
    name = "xctest_runner_info_test",
    runner = ":macos_xctest_runner",
)

xctest_runner_info_test(
    name = "watchos_xctest_runner_info_test",
    runner = "@cucumberswift//bazel:watchos_xctest_runner",
)

consumer_tests(
    name = "CucumberSwiftConsumerTests",
    # Xcode turns bare slash regex literals on by default; GeneratedBareSlashStepDefinitions.swift needs them.
    copts = ["-enable-upcoming-feature", "BareSlashRegexLiterals"],
)

consumer_tests(name = "CucumberSwiftDSLConsumerTests")

consumer_tests(
    name = "CucumberSwiftSwift6ConsumerTests",
    copts = ["-swift-version", "6"],
)

# Per-scenario coverage (#522): `bazel coverage //:CucumberSwiftCoverageTests` builds Grades with code
# coverage, and CucumberSwift writes each scenario's coverage into the test's outputs. CI checks them.
swift_library(
    name = "Grades",
    srcs = ["Grades/Grades.swift"],
    module_name = "Grades",
)

apple_resource_group(
    name = "CucumberSwiftCoverageTestsFeatures",
    strip_structured_resources_prefixes = ["CucumberSwiftCoverageTests"],
    structured_resources = glob(["CucumberSwiftCoverageTests/Features/**"]),
)

swift_library(
    name = "CucumberSwiftCoverageTestsLib",
    testonly = True,
    srcs = glob(["CucumberSwiftCoverageTests/*.swift"]),
    data = [":CucumberSwiftCoverageTestsFeatures"],
    module_name = "CucumberSwiftCoverageTests",
    deps = [
        ":Grades",
        "@cucumberswift//:CucumberSwift",
    ],
)

macos_unit_test(
    name = "CucumberSwiftCoverageTests",
    # Grades.swift is the only code the scores measure. CucumberSwift never measures its own files or the tests'.
    env = {"CUCUMBER_COVERAGE_SOURCES": "Grades.swift"},
    minimum_os_version = "10.15",
    runner = ":macos_xctest_runner",
    deps = [":CucumberSwiftCoverageTestsLib"],
)

# The same features on an iOS simulator, with rules_apple's runner, and on a watchOS simulator, with the
# cucumberswift module's runner (#534). Tagged "manual" so that `bazel test //...` leaves them out: only
# `bazel coverage` on these targets runs them.
ios_unit_test(
    name = "CucumberSwiftCoverageTests_iOS",
    env = {"CUCUMBER_COVERAGE_SOURCES": "Grades.swift"},
    minimum_os_version = "13.0",
    tags = ["manual"],
    deps = [":CucumberSwiftCoverageTestsLib"],
)

watchos_unit_test(
    name = "CucumberSwiftCoverageTests_watchOS",
    env = {"CUCUMBER_COVERAGE_SOURCES": "Grades.swift"},
    minimum_os_version = "7.4",
    runner = "@cucumberswift//bazel:watchos_xctest_runner",
    tags = ["manual"],
    deps = [":CucumberSwiftCoverageTestsLib"],
)
