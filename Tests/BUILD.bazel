load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":consumer_tests.bzl", "consumer_tests")
load("@cucumberswift//bazel:cucumberswift.bzl", "cucumberswift_fix_feature_files", "cucumberswift_generate", "cucumberswift_lint")
load("@cucumberswift//bazel:xctest_runner.bzl", "macos_xctest_runner")
load(":xctest_runner_info_test.bzl", "xctest_runner_info_test")

# From this folder: `bazel test //... --test_tag_filters=-tvos` runs each suite on macOS, on an
# iOS simulator and on a watchOS simulator, and builds it for tvOS. rules_apple can't run tvOS
# tests (see consumer_tests.bzl). CI leaves watchOS out with -watchos in both tag filters.

macos_xctest_runner(name = "macos_xctest_runner")

# Checks the runner's script with a stand-in for xctest.
sh_test(
    name = "xctest_runner_test",
    srcs = ["xctest_runner_test.sh"],
    args = ["$(rootpath @cucumberswift//bazel:xctest_runner.template.sh)"],
    data = ["@cucumberswift//bazel:xctest_runner.template.sh"],
)

# Checks the runner passes on the Xcode that Bazel selected.
xctest_runner_info_test(
    name = "xctest_runner_info_test",
    runner = ":macos_xctest_runner",
)

xctest_runner_info_test(
    name = "watchos_xctest_runner_info_test",
    runner = "@cucumberswift//bazel:watchos_xctest_runner",
)

consumer_tests(
    name = "CucumberSwiftConsumerTests",
    # Xcode turns bare slash regex literals on by default; GeneratedBareSlashStepDefinitions.swift needs them.
    copts = ["-enable-upcoming-feature", "BareSlashRegexLiterals"],
)

consumer_tests(name = "CucumberSwiftDSLConsumerTests")

consumer_tests(
    name = "CucumberSwiftSwift6ConsumerTests",
    copts = ["-swift-version", "6"],
)

# The commands of the cucumberswift tool that the plugins run, run as a Bazel project runs them: directly
# (cucumberswift_commands_test), and through the rules in bazel/cucumberswift.bzl.
sh_test(
    name = "cucumberswift_commands_test",
    srcs = ["cucumberswift_commands_test.sh"],
    args = ["$(rootpath @cucumberswift//cli:cucumberswift)"],
    data = ["@cucumberswift//cli:cucumberswift"],
)

cucumberswift_lint(
    name = "commands_lint",
    feature_files = ["CommandsFixture/Greeting.feature"],
    swift_srcs = ["CommandsFixture/Steps.swift"],
)

cucumberswift_generate(
    name = "commands_generated",
    feature_files = ["CommandsFixture/Greeting.feature"],
    swift_srcs = ["CommandsFixture/Steps.swift"],
)

cucumberswift_fix_feature_files(
    name = "commands_fix_feature_files",
    paths = ["Features"],
)

# Builds the lint stamp and the generated tests with the rules, and checks the generated tests name the scenario.
sh_test(
    name = "cucumberswift_rules_test",
    srcs = ["cucumberswift_rules_test.sh"],
    args = [
        "$(rootpath :commands_lint)",
        "$(rootpath :commands_generated)",
    ],
    data = [
        ":commands_generated",
        ":commands_lint",
    ],
)

sh_test(
    name = "cucumberswift_fix_launcher_test",
    srcs = ["cucumberswift_fix_launcher_test.sh"],
    args = ["$(rootpath :commands_fix_feature_files)"],
    data = [":commands_fix_feature_files"],
)
