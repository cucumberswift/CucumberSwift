# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
.build/
# The consumer test packages under Tests/ resolve CucumberSwiftExpressions within
# Package.swift's range, as a consumer would, so they keep no lockfile.
Tests/*/Package.resolved
# The projects in Fixtures/ resolve CucumberSwift from this checkout and keep no lockfile, and
# Tuist generates their Xcode projects (`mise run test-fixtures`).
Fixtures/*/Package.resolved
Fixtures/*/*.xcodeproj
Fixtures/*/*.xcworkspace
Fixtures/*/Derived/
Fixtures/*/.swiftpm/

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/reports
fastlane/xcov_report

node_modules
npm-debug.log
*.xcuserstate
.DS_Store

#SonarQube
.scannerwork
sq-generic.xml
.gen.swift
# Python bytecode, written when the release script tests run
__pycache__/

# Tuist
# Tuist's own scratch output. Never commit these.
.tuist-derived/
Tuist/.build/
.package.resolved

# Tuist also generates a workspace. Nothing consumes it: Carthage, fastlane and
# CI all build CucumberSwift.xcodeproj directly, and the project carries its own
# Package.resolved. Committing it would mean keeping a second generated artifact
# in step for no benefit.
CucumberSwift.xcworkspace/

# NOTE: CucumberSwift.xcodeproj is deliberately NOT ignored.
# Carthage clones this repository and runs xcodebuild against the shared
# schemes it finds in CucumberSwift.xcodeproj/xcshareddata/xcschemes/. It has
# no way to run `tuist generate` first, so the generated project and its shared
# schemes must stay in version control. See CONTRIBUTING.md.
