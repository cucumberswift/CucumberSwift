load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

# CucumberSwift's command-line tool, which users type as cucumberswift-cli with every build tool:
# `bazel run @cucumberswift//cli:cucumberswift-cli -- coverage merge <folder>` scores the scenarios of several
# runs as one run, such as a parallel run's workers or a suite's shards. Its other commands are generate, lint,
# fix-feature-files and convert-to-gherkin-macros, which the plugins run in Swift packages and Xcode projects;
# bazel/cucumberswift.bzl runs them in a Bazel project. It isn't named cucumberswift, because folders on macOS
# are not case-sensitive: a target of that name shares the CucumberSwift library's build folder, and Xcode then
# compiles the library as a module named cucumberswift (#603).
swift_binary(
    name = "cucumberswift-cli",
    srcs = ["//:Sources/CucumberSwiftCommand/main.swift"],
    module_name = "CucumberSwiftCommand",
    visibility = ["//visibility:public"],
    deps = ["//:CucumberSwiftCommandLine"],
)
