fastlane_version "2.27.0"
default_platform :ios

platform :ios do
  before_all do
    ENV["FASTLANE_EXPLICIT_OPEN_SIMULATOR"] = "2"
    clear_derived_data
  end

  # The destination is named rather than left to scan, which on the macos-15
  # runner picked none, so xcodebuild fell back to Mac Catalyst and failed to
  # sign. OS=latest is the newest iOS Simulator runtime of the selected Xcode.
  lane :unit_test do
    scan(
      code_coverage: true,
      scheme:  'CucumberSwift',
      project: 'CucumberSwift.xcodeproj',
      destination: 'platform=iOS Simulator,name=iPhone 16,OS=latest'
    )
  end

  lane :build_swiftpm do
    spm(
      command: "build",
      build_path: "./build",
      configuration: "release"
    )
  end

  lane :cocoapods_liblint do
    pod_lib_lint(podspec: 'CucumberSwift.podspec', allow_warnings: true)
  end

  desc "Release a new version with a patch bump_type"
  lane :patch do
    release("patch")
  end

  desc "Release a new version with a minor bump_type"
  lane :minor do
    release("minor")
  end

  desc "Release a new version with a major bump_type"
  lane :major do
    release("major")
  end

  def release(type)
    podspec_name = "CucumberSwift.podspec"
    version = version_bump_podspec(path: podspec_name,
                                   bump_type: type)
    update_plist(
      plist_path: "Sources/CucumberSwift/Info.plist",
      block: proc do |plist|
        plist[:CFBundleVersion] = version
      end
    )
  end
end
